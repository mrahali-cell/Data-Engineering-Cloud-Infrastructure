# Copy to .env and fill in. Never commit .env.
SNOWFLAKE_ACCOUNT=ywwmmfz-gv99460
# Your LOGIN name, not the user name: run DESC USER "<you>" in Snowflake and copy LOGIN_NAME
# (key-pair login fails with "JWT token is invalid" otherwise)
SNOWFLAKE_USER=YOUR_LOGIN_NAME
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=MEDIRELAIS_WH
SNOWFLAKE_DATABASE=MEDIRELAIS
# Optional: cloud landing zone for S2. Leave empty to use Snowflake's internal stage.
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
