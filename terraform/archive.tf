# Archive: old raw data leaves Snowflake for cheap storage we own, as the last step of the
# daily DAG (COPY INTO @MEDIRELAIS.BRONZE.ARCHIVE_STAGE ...). Snowflake reaches the bucket
# through a storage integration and an IAM role: no AWS key is stored anywhere.
#
# The integration and the IAM role need each other (the role trusts the integration's AWS
# user; the integration names the role). The role ARN is built from its name, so Snowflake
# can be told about the role before the role exists, and there is no cycle.

data "aws_caller_identity" "current" {}

locals {
  archive_bucket   = "medirelais-archive-${data.aws_caller_identity.current.account_id}"
  archive_role     = "medirelais-snowflake-archive"
  archive_role_arn = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/${local.archive_role}"
}

# --- AWS: the bucket --------------------------------------------------------------------

resource "aws_s3_bucket" "archive" {
  bucket = local.archive_bucket
}

resource "aws_s3_bucket_public_access_block" "archive" {
  bucket                  = aws_s3_bucket.archive.id
  block_public_acls       = true
  ignore_public_acls      = true
  block_public_policy     = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "archive" {
  bucket = aws_s3_bucket.archive.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# Storage gets cheaper as data gets older: Glacier after 90 days, Deep Archive after 1 year.
# Snowflake can still write here every day; reading a file back from Glacier needs a restore first.
resource "aws_s3_bucket_lifecycle_configuration" "archive" {
  bucket = aws_s3_bucket.archive.id

  rule {
    id     = "glacier-then-deep-archive"
    status = "Enabled"
    filter {}

    transition {
      days          = 90
      storage_class = "GLACIER"
    }
    transition {
      days          = 365
      storage_class = "DEEP_ARCHIVE"
    }
    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }
}

# --- Snowflake: the integration ------------------------------------------------------
# Needs CREATE INTEGRATION on SYSADMIN. Only ACCOUNTADMIN can grant it, and Terraform never
# runs as ACCOUNTADMIN, so that one grant is a manual step (terraform/bootstrap.sql).

resource "snowflake_storage_integration_aws" "archive" {
  name                      = "MEDIRELAIS_ARCHIVE_INT"
  enabled                   = true
  storage_provider          = "S3"
  storage_allowed_locations = ["s3://${local.archive_bucket}/"]
  storage_aws_role_arn      = local.archive_role_arn
  comment                   = "MediRelais archive bucket (S3, eu-north-1)"
}

# --- AWS: the role Snowflake assumes, trusting only this integration ---------------------

resource "aws_iam_role" "snowflake_archive" {
  name = local.archive_role

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { AWS = snowflake_storage_integration_aws.archive.describe_output[0].iam_user_arn }
      Action    = "sts:AssumeRole"
      Condition = {
        StringEquals = { "sts:ExternalId" = snowflake_storage_integration_aws.archive.describe_output[0].external_id }
      }
    }]
  })
}

# Least privilege: this bucket only; write and read objects, list the bucket. No delete of the bucket.
locals {
  archive_bucket_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:DeleteObjectVersion"]
        Resource = "${aws_s3_bucket.archive.arn}/*"
      },
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket", "s3:GetBucketLocation"]
        Resource = aws_s3_bucket.archive.arn
      },
    ]
  })
}

resource "aws_iam_role_policy" "snowflake_archive" {
  name   = "archive-bucket-access"
  role   = aws_iam_role.snowflake_archive.id
  policy = local.archive_bucket_policy
}

# --- Fallback while the AWS Free plan blocks the integration ---------------------------
# The plan's organization guardrails refuse Snowflake's AWS account when it assumes the
# role above. A user inside our own account is allowed, so until the plan is upgraded the
# stage signs in as a dedicated IAM user with the same bucket-only policy. Its key is
# generated by Terraform and goes straight into the stage: it is never typed or printed,
# and only lives in the encrypted state. Set archive_use_storage_integration = true after
# an upgrade: the user and its key are deleted and the stage switches to the role.

resource "aws_iam_user" "snowflake_archive" {
  count = var.archive_use_storage_integration ? 0 : 1
  name  = "medirelais-snowflake-archive-writer"
}

resource "aws_iam_user_policy" "snowflake_archive" {
  count  = var.archive_use_storage_integration ? 0 : 1
  name   = "archive-bucket-access"
  user   = aws_iam_user.snowflake_archive[0].name
  policy = local.archive_bucket_policy
}

resource "aws_iam_access_key" "snowflake_archive" {
  count = var.archive_use_storage_integration ? 0 : 1
  user  = aws_iam_user.snowflake_archive[0].name
}

# --- Snowflake: the stage the DAG writes to -------------------------------------------

resource "snowflake_stage_external_s3" "archive" {
  name                = "ARCHIVE_STAGE"
  database            = snowflake_database.medirelais.name
  schema              = snowflake_schema.layer["BRONZE"].name
  url                 = "s3://${local.archive_bucket}/"
  storage_integration = var.archive_use_storage_integration ? snowflake_storage_integration_aws.archive.name : null
  comment             = "Old raw data unloaded from bronze; Glacier after 90 days, Deep Archive after 1 year"

  dynamic "credentials" {
    for_each = var.archive_use_storage_integration ? [] : [1]
    content {
      aws_key_id     = aws_iam_access_key.snowflake_archive[0].id
      aws_secret_key = aws_iam_access_key.snowflake_archive[0].secret
    }
  }

  depends_on = [aws_iam_role_policy.snowflake_archive, aws_iam_user_policy.snowflake_archive]
}

# The pipeline role (Airflow) can write to the stage, nothing more
resource "snowflake_grant_privileges_to_account_role" "pipeline_archive_stage" {
  provider          = snowflake.security
  account_role_name = snowflake_account_role.pipeline.name
  privileges        = ["USAGE"]
  on_schema_object {
    object_type = "STAGE"
    object_name = snowflake_stage_external_s3.archive.fully_qualified_name
  }
}

output "archive_bucket" {
  value = aws_s3_bucket.archive.bucket
}

output "archive_stage" {
  value = snowflake_stage_external_s3.archive.fully_qualified_name
}
